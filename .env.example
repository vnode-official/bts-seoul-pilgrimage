# Naver Cloud Maps JavaScript API client id (ncpClientId / ncpKeyId)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# HS256 secret for httpOnly Pass session cookies (jose)
JWT_SECRET=replace-with-a-long-random-string

# Lemon Squeezy — Premium Pass $19.99
LEMON_SQUEEZY_VARIANT_ID=
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Set true to keep the labeled local demo unlock even if NODE_ENV=production
ALLOW_DEMO_UNLOCK=true
