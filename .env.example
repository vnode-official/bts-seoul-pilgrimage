# Naver Cloud Maps JavaScript API
# Console: https://console.ncloud.com/ → Services → AI·NAVER API → Application
# Maps → Dynamic Map. Copy Client ID into ncpClientId / ncpKeyId.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Kakao Developers — https://developers.kakao.com/
# Create an app. Platform → Web (add your domain, including *.vercel.app).
# App key → JavaScript key (static station preview + Kakao Map links)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
# App key → REST API key (server-only Kakao Navi directions)
KAKAO_REST_API_KEY=

# Seoul Open Data — subway realtime arrivals + train positions
# Dataset: 서울시 지하철 실시간 도착정보 (OA-12764)
# https://data.seoul.go.kr/dataList/OA-12764/F/1/datasetView.do
# Authentication key from the portal (not the bus key below).
SEOUL_OPEN_API_KEY=

# 공공데이터포털 — Seoul TOPIS bus stop arrivals + WGS84 bus GPS
# Apply for 서울특별시_정류소정보조회서비스 / 버스위치정보
# https://www.data.go.kr/ — paste the Decoding service key (not the already-encoded one).
DATA_GO_KR_SERVICE_KEY=
# Optional alias for the same bus key
SEOUL_BUS_API_KEY=

# HS256 secret for httpOnly Pass session cookies (jose)
JWT_SECRET=replace-with-a-long-random-string

# Lemon Squeezy — Premium Pass $19.99
LEMON_SQUEEZY_VARIANT_ID=
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Set true to keep the labeled local demo unlock even if NODE_ENV=production
ALLOW_DEMO_UNLOCK=true

# Optional public origin for Lemon redirect_url (defaults to the incoming Host)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:47501
