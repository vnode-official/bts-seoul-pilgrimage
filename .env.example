# HS256 secret for httpOnly Pass session cookies (jose)
JWT_SECRET=replace-with-a-long-random-string

# Public origin for Lemon redirect_url (production: https://bts-seoul-pilgrimage.vercel.app)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:47501

# Lemon Squeezy — Seoul Pilgrimage Pass (~$19.99). Never commit real keys.
# Overlay checkout needs the public variant id. Store slug is the subdomain
# in https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=
NEXT_PUBLIC_LEMON_SQUEEZY_STORE_ID=
NEXT_PUBLIC_LEMON_SQUEEZY_STORE_SLUG=

# Server-only. Optional API checkout + order verification.
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Local demo Pass cookie. Ignored when NODE_ENV=production.
ALLOW_DEMO_UNLOCK=true

# --- Not required for core UX. Do not create a Naver Cloud account for this app. ---
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
KAKAO_REST_API_KEY=

SEOUL_OPEN_API_KEY=
DATA_GO_KR_SERVICE_KEY=
SEOUL_BUS_API_KEY=
