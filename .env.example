# Naver Cloud Maps — required for the monetization MVP
# Console: https://console.ncloud.com/ → AI·NAVER API → Application → Maps
# Enable Dynamic Map. Copy Client ID (ncpClientId / ncpKeyId).
# Register https://bts-seoul-pilgrimage.vercel.app as a Web service URL.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Optional: same Naver app Client Secret — walking polyline overlay (Directions REST)
NAVER_MAP_CLIENT_SECRET=

# HS256 secret for httpOnly Pass session cookies (jose). Already set on Vercel.
JWT_SECRET=replace-with-a-long-random-string

# Optional Lemon Squeezy — Premium Pass $19.99 checkout
LEMON_SQUEEZY_VARIANT_ID=
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Set true to keep the labeled local demo unlock even if NODE_ENV=production
ALLOW_DEMO_UNLOCK=true

# Optional public origin for Lemon redirect_url
NEXT_PUBLIC_APP_URL=http://127.0.0.1:47501

# --- Optional. Not required for the Pass map + Naver routing UX. ---

# Kakao T still works without these (deep-link only).
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
KAKAO_REST_API_KEY=

# Seoul live arrivals / bus GPS — hidden unless set. Never faked.
SEOUL_OPEN_API_KEY=
DATA_GO_KR_SERVICE_KEY=
SEOUL_BUS_API_KEY=
